{
  "name": "zijemevzidech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "SKIP_API_FETCH=1 opennextjs-cloudflare build",
    "build:static": "STATIC_EXPORT=1 next build",
    "generate-paths": "node scripts/generate-paths.js",
    "prepare": "git config core.hooksPath .githooks",
    "start": "next start",
    "lint": "next lint",
    "preview": "yarn build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "yarn build:cloudflare && opennextjs-cloudflare deploy -- --keep-vars",
    "upload": "yarn build:cloudflare && opennextjs-cloudflare upload -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "@react-google-maps/api": "^2.19.3",
    "@tanstack/react-query": "^5.59.15",
    "next": "^15.5.0",
    "photoswipe": "^5.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-photoswipe-gallery": "^3.0.2",
    "sass": "^1.79.4"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
