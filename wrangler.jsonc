{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "zijemevzidech",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // Same-zone API fetches need api.* orange-clouded (proxied) — see README.
  // Keep api on the origin host; only the Next app runs on this Worker.
  "vars": {
    "API_BASE": "https://api.zijemevzidech.cz/json/",
    "EE_BASE": "https://api.zijemevzidech.cz/index.php",
    "SITE_BASE": "https://zijemevzidech.cz/",
    "NEXT_PUBLIC_API_BASE": "https://api.zijemevzidech.cz/json/",
    "NEXT_PUBLIC_EE_BASE": "https://api.zijemevzidech.cz/index.php",
    "NEXT_PUBLIC_SITE_BASE": "https://zijemevzidech.cz/"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zijemevzidech"
    }
  ],
   "routes": [
     { "pattern": "zijemevzidech.cz", "custom_domain": true },
     { "pattern": "www.zijemevzidech.cz", "custom_domain": true }
   ]
}
